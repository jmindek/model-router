# OpenRouter API key (standard env var)
OPENROUTER_API_KEY=sk-or-v1-...

# System One model API key (for routing decisions)
ROUTER_API_KEY=sk-or-v1-...

# System One model
ROUTER_MODEL=upstage/solar-decide

# System One API base
ROUTER_API_BASE=https://openrouter.ai/api/v1

# OpenRouter inventory URL
ROUTER_INVENTORY_URL=https://openrouter.ai/api/v1

# Routing mode: cloud, local, auto
ROUTER_MODE=auto

# Local oMLX base URL
ROUTER_OMLX_BASE=http://127.0.0.1:8000

# Minimum discount threshold (0.0-1.0)
ROUTER_MIN_DISCOUNT=0.50

# Fallback mode: halt, static
ROUTER_FALLBACK_MODE=static

# Static fallback model ID
ROUTER_STATIC_FALLBACK=openrouter/deepseek/deepseek-v3.1

# LiteLLM proxy URL
ROUTER_LITELLM_PROXY=http://litellm:4000

# Use LiteLLM for tracing
ROUTER_USE_LITELLM=true

# Cache file path
ROUTER_CACHE_FILE=data/models.json

# Inventory refresh cron (default: 2am UTC)
ROUTER_REFRESH_CRON=0 2 * * *

# OpenTelemetry endpoint (gRPC). Empty = console exporter.
# Set to e.g. http://localhost:4317 for Langfuse, Honeycomb, etc.
OTEL_ENDPOINT=

# Model handoff when selected model falls off discount list:
#   stop       - return 400 with message (user must pick new model)
#   next_best  - auto-switch to best discounted model (default)
#   keep_current - continue with the model even if not discounted
ROUTER_MODEL_HANDOFF=next_best
